# 이 파일을 복사해 .env 로 만들고 값을 채우세요. (.env 는 .gitignore 처리됨)
# 키가 비어 있으면 해당 외부 조회는 자동으로 건너뜁니다(확장은 정상 동작).

# abuse.ch URLhaus — URL 평판 조회. https://urlhaus.abuse.ch/api/ 에서 Auth-Key 발급
URLHAUS_API_KEY=

# Google Safe Browsing v4 — https://developers.google.com/safe-browsing 에서 API 키 발급
SAFE_BROWSING_API_KEY=

# 국세청 사업자등록 상태조회 (data.go.kr odcloud) 서비스키
NTS_SERVICE_KEY=

# 선택: NTS 베이스 URL 재정의
# NTS_BASE_URL=https://api.odcloud.kr/api/nts-businessman/v1
